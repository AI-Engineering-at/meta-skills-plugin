#!/bin/zsh
# Canonical OpenCode peer launcher — the single entry point for Brain/Vibe sessions.
#
# This is the canonical launcher living at the meta-skills-plugin root. Wrappers
# in integrations/opencode/bin/ delegate here. It selects exactly one role-bound
# OpenCode primary agent (brain|vibe), one Mattermost write channel, and resolves
# the Phantom Bridge client token from the vault at process start without writing
# it to disk or printing it to stdout.
#
# Usage:
#   ./launcher --role brain|vibe [--channel team-infra|town-square] [session options]
#   ./launcher --role brain run "prompt"
#
# 2026-08-02 (TASK-2026-00968): Die Vorgabe war `agent-tasks` — ein Kanal, den es
# nicht gibt. Gemessen: GET /teams/{tid}/channels/name/agent-tasks -> HTTP 404,
# waehrend team-infra/town-square/brain mit derselben Sonde HTTP 200 liefern; in
# der vollstaendigen Enumeration (3 oeffentlich + 7 privat + 0 archiviert = 10 von
# 10) kommt der Name nicht vor. Der Fehlschlag war STILL, nicht laut: die Suche
# `in:agent-tasks` antwortet HTTP 200 mit order=0 — von einem existierenden, aber
# ruhigen Kanal nicht zu unterscheiden. Jede Peer-Sitzung hielt also einen leeren
# Posteingang fuer Ruhe. Vorgabe jetzt team-infra (existiert, brain ist Mitglied,
# 5 von 5 Mitglieder: joe, brain, tim, lisa, tron).

set -euo pipefail

usage() {
  print -u2 "Usage: launcher --role brain|vibe [--channel team-infra|town-square] [OpenCode session options]"
  exit 64
}

role=""
channel="team-infra"
typeset -a forwarded

while (( $# > 0 )); do
  case "$1" in
    --role)
      (( $# >= 2 )) || usage
      role="$2"
      shift 2
      ;;
    --channel)
      (( $# >= 2 )) || usage
      channel="$2"
      shift 2
      ;;
    --)
      shift
      forwarded=("$@")
      break
      ;;
    --agent|--agent=*)
      print -u2 "Refusing agent override: the selected peer role determines the OpenCode agent."
      exit 64
      ;;
    *)
      forwarded+=("$1")
      shift
      ;;
  esac
done

for argument in "${forwarded[@]}"; do
  case "$argument" in
    --agent|--agent=*)
      print -u2 "Refusing agent override: the selected peer role determines the OpenCode agent."
      exit 64
      ;;
  esac
done

case "$role" in
  brain|vibe) ;;
  *) usage ;;
esac

case "$channel" in
  team-infra|town-square) ;;
  *)
    print -u2 "Unsupported peer channel: $channel"
    exit 64
    ;;
esac

# Resolve plugin root (this script's directory = .opencode-plugin/)
plugin_dir="${0:A:h}"

# Resolve the canonical profile location (absolute, no embedded ..)
profiles_dir="$(cd "$plugin_dir/../integrations/opencode/profiles" 2>/dev/null && pwd -P)" || {
  print -u2 "Profile directory not found: $plugin_dir/../integrations/opencode/profiles"
  exit 66
}
profile="$profiles_dir/opencode.$role.jsonc"
[[ -r "$profile" ]] || {
  print -u2 "Missing OpenCode profile: $profile"
  exit 66
}

case "${forwarded[1]:-}" in
  web|serve)
    # web/serve don't support --agent — just run directly
    exec opencode "${forwarded[@]}"
    ;;
  mcp|agent|completion|debug|db|github|models|plugin|providers|session|stats|export|import)
    print -u2 "This launcher starts peer sessions only. Run OpenCode administration commands directly."
    exit 64
    ;;
esac

# Resolve the Phantom Bridge client token from the vault for this session only.
# Never write it to an OpenCode config file or print it to output.
vault_bin="${AIE_VAULT_BIN:-$HOME/code-aie/aie-secret-vault/.venv/bin/aie-vault}"
[[ -x "$vault_bin" ]] || {
  print -u2 "Bridge session cannot start: vault CLI unavailable."
  exit 69
}
unset PHANTOM_BRIDGE_CLIENT_TOKEN
bridge_client_token="$("$vault_bin" get phantom-bridge "client-token-opencode-$role" --raw 2>/dev/null)" || {
  print -u2 "Bridge session cannot start: client token resolution failed."
  exit 69
}
[[ -n "$bridge_client_token" ]] || {
  print -u2 "Bridge session cannot start: client token is empty."
  exit 69
}
export PHANTOM_BRIDGE_CLIENT_TOKEN="$bridge_client_token"
unset bridge_client_token

export AIE_MM_ROLE="$role"
export AIE_OPENCODE_AGENT="$role"
export AIE_MM_READ_CHANNEL_NAMES="$channel"
export AIE_MM_WRITE_CHANNEL_NAMES="$channel"
export OPENCODE_CONFIG="$profile"

print "OpenCode peer role=$role agent=$role channel=$channel"
if (( ${#forwarded[@]} > 0 )) && [[ "${forwarded[1]}" == "run" ]]; then
  exec opencode run --agent "$role" "${forwarded[@]:1}"
fi

exec opencode --agent "$role" "${forwarded[@]}"
