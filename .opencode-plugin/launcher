#!/bin/zsh
# Canonical OpenCode team launcher — one entry point for every persistent role.
#
# This is the canonical launcher living at the meta-skills-plugin root. Wrappers
# in integrations/opencode/bin/ delegate here. It selects exactly one role-bound
# OpenCode primary agent (brain|vibe), one Mattermost write channel, and resolves
# the Phantom Bridge client token from the vault at process start without writing
# it to disk or printing it to stdout.
#
# Usage:
#   ./launcher --role brain|vibe|ocode-kimi|ocode-pruefer [--channel ocode-team] [session options]
#   ./launcher --role brain run "prompt"
#
# 2026-08-02 (TASK-2026-00968): Die Vorgabe war `agent-tasks` — ein Kanal, den es
# nicht gibt. Gemessen: GET /teams/{tid}/channels/name/agent-tasks -> HTTP 404,
# waehrend team-infra/town-square/brain mit derselben Sonde HTTP 200 liefern; in
# der vollstaendigen Enumeration (3 oeffentlich + 7 privat + 0 archiviert = 10 von
# 10) kommt der Name nicht vor. Der Fehlschlag war STILL, nicht laut: die Suche
# `in:agent-tasks` antwortet HTTP 200 mit order=0 — von einem existierenden, aber
# ruhigen Kanal nicht zu unterscheiden. Jede Peer-Sitzung hielt also einen leeren
# Posteingang fuer Ruhe. Der heutige Standard ist `ocode-team`; `team-infra` und
# `town-square` bleiben nur explizite Kompatibilitaetspfade.

set -euo pipefail

usage() {
  print -u2 "Usage: launcher --role brain|vibe|ocode-kimi|ocode-pruefer [--channel team-infra|town-square|ocode-team] [OpenCode session options]"
  exit 64
}

role=""
channel="ocode-team"
channel_explicit=0
typeset -a forwarded

while (( $# > 0 )); do
  case "$1" in
    --role)
      (( $# >= 2 )) || usage
      role="$2"
      shift 2
      ;;
    --channel)
      (( $# >= 2 )) || usage
      channel="$2"
      channel_explicit=1
      shift 2
      ;;
    --)
      shift
      forwarded=("$@")
      break
      ;;
    --agent|--agent=*)
      print -u2 "Refusing agent override: the selected peer role determines the OpenCode agent."
      exit 64
      ;;
    *)
      forwarded+=("$1")
      shift
      ;;
  esac
done

for argument in "${forwarded[@]}"; do
  case "$argument" in
    --agent|--agent=*)
      print -u2 "Refusing agent override: the selected peer role determines the OpenCode agent."
      exit 64
      ;;
  esac
done

case "$role" in
  brain|vibe|ocode-kimi|ocode-pruefer) ;;
  *) usage ;;
esac

case "$channel" in
  team-infra|town-square|ocode-team) ;;
  *)
    print -u2 "Unsupported peer channel: $channel"
    exit 64
    ;;
esac

# Resolve plugin root (this script's directory = .opencode-plugin/)
plugin_dir="${0:A:h}"

# Resolve the canonical profile location (absolute, no embedded ..)
profiles_dir="$(cd "$plugin_dir/../integrations/opencode/profiles" 2>/dev/null && pwd -P)" || {
  print -u2 "Profile directory not found: $plugin_dir/../integrations/opencode/profiles"
  exit 66
}
profile="$profiles_dir/opencode.$role.jsonc"
[[ -r "$profile" ]] || {
  print -u2 "Missing OpenCode profile: $profile"
  exit 66
}

case "${forwarded[1]:-}" in
  web|serve)
    # web/serve don't support --agent — just run directly
    exec opencode "${forwarded[@]}"
    ;;
  mcp|agent|completion|debug|db|github|models|plugin|providers|session|stats|export|import)
    print -u2 "This launcher starts peer sessions only. Run OpenCode administration commands directly."
    exit 64
    ;;
esac

# Bridge-T2 quarantine: every peer uses direct opencode/* models. No launcher
# may resolve or inject a Bridge client token before the explicit T2 exit gate.
unset PHANTOM_BRIDGE_CLIENT_TOKEN

# A resumed persistent role tells the inbox plugin which exact session it owns.
# This removes lifecycle-event ambiguity and lets Mattermost target the named
# session without first requiring a local keyboard prompt.
session_id=""
for (( index = 1; index <= ${#forwarded[@]}; index++ )); do
  argument="${forwarded[$index]}"
  case "$argument" in
    --session|-s)
      (( index < ${#forwarded[@]} )) || usage
      session_id="${forwarded[$(( index + 1 ))]}"
      (( index++ ))
      ;;
    --session=*|-s=*)
      session_id="${argument#*=}"
      ;;
  esac
done
if [[ -n "$session_id" ]]; then
  export AIE_OPENCODE_SESSION_ID="$session_id"
else
  unset AIE_OPENCODE_SESSION_ID
fi

export AIE_MM_ROLE="$role"
export AIE_OPENCODE_AGENT="$role"
export AIE_MM_READ_CHANNEL_NAMES="$channel"
export AIE_MM_WRITE_CHANNEL_NAMES="$channel"
export OPENCODE_CONFIG="$profile"

print "OpenCode peer role=$role agent=$role channel=$channel"
typeset -a team_approval
team_approval=()
if [[ "$role" == "brain" || "$role" == "vibe" || "$role" == ocode-* ]]; then
  # 2026-08-12 (Joe): brain ist Leader und Orchestrator -> volle Rechte,
  # keine Permission-Fragen. Alle Peer-Rollen starten mit --auto; deny-Regeln
  # aus den Profilen bleiben trotzdem aktiv (--auto approvt nur, was nicht
  # explizit deny ist). Ohne --auto bleiben Team-Sitzungen an erlaubten
  # lokalen Werkzeugen stehen und koennen einen Mattermost-Auftrag nicht
  # autonom abarbeiten.
  team_approval=(--auto)
fi
if (( ${#forwarded[@]} > 0 )) && [[ "${forwarded[1]}" == "run" ]]; then
  exec opencode run --agent "$role" "${team_approval[@]}" "${forwarded[@]:1}"
fi

exec opencode --agent "$role" "${team_approval[@]}" "${forwarded[@]}"
