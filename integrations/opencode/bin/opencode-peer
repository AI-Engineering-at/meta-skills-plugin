#!/bin/zsh
# Thin wrapper — delegates to the canonical launcher at .opencode-plugin/launcher.
# This keeps the established PATH entry (integrations/opencode/bin/) working while
# ensuring the canonical launch site remains the single source of truth.

set -euo pipefail

# Resolve the meta-skills-plugin root from this script's real path.
# ${0:A:h} resolves symlinks and gives the absolute directory of this script.
plugin_root="$(cd "${0:A:h}"/../../.. && pwd -P)"
launcher="$plugin_root/.opencode-plugin/launcher"

[[ -x "$launcher" ]] || {
  print -u2 "Canonical launcher not found: $launcher"
  exit 66
}

exec "$launcher" "$@"
