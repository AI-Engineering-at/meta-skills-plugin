{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "external_directory": {
      "/Users/mackbook/code-aie/worktrees/bridge-01322-deploy-convergence/**": "allow"
    }
  },
  "default_agent": "ocode-kimi",
  "agent": {
    "ocode-kimi": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Bounded OCode builder; only explicit ERPNext tasks in its isolated worktree.",
      "permission": {"webfetch": "deny", "websearch": "deny"}
    }
  },
  "plugin": [
    "file:///Users/mackbook/code-aie/meta-skills-plugin/integrations/opencode/plugins/peer-inbox.mjs"
  ],
  "mcp": {
    "aie-mm-mcp": {
      "type": "local",
      "command": ["/Users/mackbook/code-aie/aie-mm-mcp/.venv/bin/python", "-m", "aie_mm_mcp.server"],
      "enabled": true,
      "env": {"AIE_BOT_ID": "aie-mm-mcp-ocode-kimi", "AIE_MM_ROLE": "ocode-kimi"}
    }
  }
}
