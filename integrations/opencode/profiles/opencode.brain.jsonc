{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "aie-mm-mcp_*": "allow"
  },
  "skills": {
    "paths": [
      "/Users/mackbook/code-aie/meta-skills-plugin/skills",
      "/Users/mackbook/code-aie/meta-skills-plugin/.opencode-plugin/skills"
    ]
  },
  // 2026-08-12 (Joe, improvisiert): Gehirn soll echte Modelle nutzen koennen,
  // nicht nur die anonymen Worker. big-pickle bleibt Fallback fuer 0-Credential-
  // Betrieb; sobald `opencode auth login` einen Provider registriert, kann brain
  // in der Session per /models auf ein echtes Modell wechseln. Kein Standard.
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "default_agent": "brain",
  "agent": {
    "brain": {
      "mode": "primary",
      // Improvisiert (2026-08-12): nicht mehr hart gepinnt auf den Worker.
      // Fehlt das Modell, erbt brain das Fallback aus der Profilebene oben.
      "description": "Brain: infrastructure authority and final acceptance.",
      "prompt": "You are Brain. Own infrastructure decisions and final acceptance. Keep peer coordination in the configured Mattermost channel and record durable evidence in Gitea."
    }
  },
  "plugin": [
    "file:///Users/mackbook/code-aie/meta-skills-plugin/integrations/opencode/plugins/peer-inbox.mjs"
  ],
  "mcp": {
    "aie-mm-mcp": {
      "type": "local",
      "command": [
        "/Users/mackbook/code-aie/aie-mm-mcp/.venv/bin/python",
        "-m",
        "aie_mm_mcp.server"
      ],
      "enabled": true,
      "environment": {
        "AIE_BOT_ID": "aie-mm-mcp-brain",
        "AIE_MM_ROLE": "brain"
      }
    }
  }
}
